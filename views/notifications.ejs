<% var page = 'notifications'; %>
<%- include('partials/header', { title: t('notif.sectionTitle'), page: 'notifications' }) %>

<div class="page-header">
  <div>
    <h1>&#128276; <%= t('notif.sectionTitle') %></h1>
    <p class="page-description"><%= t('notif.sectionDesc') %></p>
  </div>
</div>

<div class="form-container" style="max-width: 680px;">
  <div class="form-card">
    <form method="POST" action="/repos/settings/notifications">
      <%- (typeof csrfInput !== 'undefined' ? csrfInput : '') %>
      <div class="form-group">
        <label for="discordUrl"><%= t('notif.discordUrl') %></label>
        <input type="url" id="discordUrl" name="discordUrl" value="<%= typeof discordUrl !== 'undefined' ? discordUrl : '' %>" placeholder="<%= t('notif.discordPlaceholder') %>" autocomplete="off">
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%= t('button.save') %></button>
        <a href="/repos" class="btn btn-secondary"><%= t('button.back') %></a>
      </div>
    </form>
  </div>
</div>

<div class="form-container" style="max-width: 680px;margin-top:20px;">
  <div class="form-card">
    <div class="section-title" style="margin-top:0;">&#128241; <%= t('push.title') %></div>
    <p class="muted" style="font-size:13px;line-height:1.6;"><%= t('push.desc') %></p>
    <div id="pushStatus" class="muted" style="font-size:13px;margin-bottom:12px;"><%= t('push.count') %>: <span id="pushCount">-</span></div>
    <div style="display:flex;gap:10px;flex-wrap:wrap;">
      <button type="button" id="pushEnableBtn" class="btn btn-primary btn-sm" onclick="enablePush()"><%= t('push.enable') %></button>
      <button type="button" id="pushDisableBtn" class="btn btn-secondary btn-sm" onclick="disablePush()" style="display:none;"><%= t('push.disable') %></button>
      <button type="button" id="pushTestBtn" class="btn btn-secondary btn-sm" onclick="testPush()"><%= t('push.test') %></button>
    </div>
    <div id="pushMessage" class="muted" style="font-size:12px;margin-top:10px;"></div>
  </div>
</div>

<script>
var pushPublicKey = null;
var currentSubscription = null;

function urlBase64ToUint8Array(base64String) {
  var padding = '='.repeat((4 - base64String.length % 4) % 4);
  var base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
  var raw = atob(base64);
  var out = new Uint8Array(raw.length);
  for (var i = 0; i < raw.length; i++) out[i] = raw.charCodeAt(i);
  return out;
}

function setPushMessage(text) {
  var el = document.getElementById('pushMessage');
  if (el) el.textContent = text;
}

async function refreshPushState() {
  if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
    setPushMessage('<%= t('push.unsupported') %>');
    document.getElementById('pushEnableBtn').style.display = 'none';
    return;
  }
  try {
    var res = await fetch('/repos/settings/push/status');
    var data = await res.json();
    if (!data.ok) return;
    pushPublicKey = data.publicKey;
    document.getElementById('pushCount').textContent = data.count;
    var reg = await navigator.serviceWorker.ready;
    currentSubscription = await reg.pushManager.getSubscription();
    var subscribed = !!currentSubscription;
    document.getElementById('pushEnableBtn').style.display = subscribed ? 'none' : '';
    document.getElementById('pushDisableBtn').style.display = subscribed ? '' : 'none';
    if (subscribed) setPushMessage('<%= t('push.enabled') %>');
  } catch (err) {
    setPushMessage(err.message);
  }
}

async function enablePush() {
  if (!pushPublicKey) return;
  try {
    var permission = await Notification.requestPermission();
    if (permission !== 'granted') {
      setPushMessage('<%= t('push.unsupported') %>');
      return;
    }
    var reg = await navigator.serviceWorker.ready;
    var sub = await reg.pushManager.subscribe({
      userVisibleOnly: true,
      applicationServerKey: urlBase64ToUint8Array(pushPublicKey),
    });
    var res = await fetch('/repos/settings/push/subscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ subscription: sub.toJSON() }),
    });
    var data = await res.json();
    if (!data.ok) throw new Error(data.error || 'subscribe failed');
    setPushMessage('<%= t('push.enabled') %>');
    await refreshPushState();
  } catch (err) {
    setPushMessage(err.message);
  }
}

async function disablePush() {
  try {
    var reg = await navigator.serviceWorker.ready;
    var sub = await reg.pushManager.getSubscription();
    if (sub) {
      await fetch('/repos/settings/push/unsubscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ endpoint: sub.endpoint }),
      });
      await sub.unsubscribe();
    }
    setPushMessage('');
    await refreshPushState();
  } catch (err) {
    setPushMessage(err.message);
  }
}

async function testPush() {
  try {
    var res = await fetch('/repos/settings/push/test', { method: 'POST' });
    var data = await res.json();
    if (!data.ok) throw new Error(data.error || 'test failed');
    setPushMessage('<%= t('push.testSent') %> (' + data.sent + '/' + (data.sent + data.failed) + ')');
  } catch (err) {
    setPushMessage(err.message);
  }
}

refreshPushState();
</script>

<%- include('partials/footer') %>
