<% var page = 'add'; %>
<%- include('partials/header', { title: t('page.add.title'), page: 'add' }) %>

<div class="page-header">
  <div>
    <h1><%= t('page.add.title') %></h1>
    <p class="page-description"><%= t('page.add.subtitle') %></p>
  </div>
</div>

<div class="form-container" style="max-width:680px;">
  <div class="form-card">
    <h2><%= t('add.existingTitle') %></h2>
    <p class="subtitle"><%= t('add.existingDesc') %></p>

    <% if (accounts.length === 0) { %>
      <div class="alert alert-danger" style="margin-bottom:16px;" id="noAccountAlert">
        <span id="noAccountPrefix"></span> <a href="/repos/settings"><%= t('alert.noAccountsLink') %></a> <span id="noAccountSuffix"></span>
      </div>
    <% } %>

    <form method="POST" action="/repos/add">
      <%- (typeof csrfInput !== 'undefined' ? csrfInput : '') %>
      <div class="form-group">
        <label for="githubPicker"><%= t('add.pickGithub') %></label>
        <select id="githubPicker">
          <option value=""><%= t('add.pickGithubPlaceholder') %></option>
        </select>
        <span class="help-text" id="githubPickerHelp"><%= t('add.pickGithubHint') %></span>
      </div>
      <div class="form-group">
        <label for="agentId"><%= t('add.target') %></label>
        <select id="agentId" name="agentId">
          <option value=""><%= t('add.serverDefault') %></option>
          <% if (typeof nodes !== 'undefined' && nodes.length) { nodes.forEach(function(n) { %>
            <option value="<%= n.id %>"><%= n.name %> (<%= n.platform %>)</option>
          <% }); } %>
        </select>
        <span class="help-text" id="agentHelp"><%= t('add.targetHint') %></span>
      </div>
      <div class="form-group">
        <label for="name"><%= t('field.name') %></label>
        <input type="text" id="name" name="name" required autofocus placeholder="<%= t('placeholder.name') %>">
        <span class="help-text"><%= t('field.nameHint') %></span>
      </div>
      <div class="form-group">
        <label for="accountId"><%= t('field.account') %></label>
        <select id="accountId" name="accountId" <%= accounts.length === 0 ? 'disabled' : '' %>>
          <option value="" selected><%= t('field.accountAuto') %></option>
          <% accounts.forEach(function(acc) { %>
            <option value="<%= acc.id %>"><%= acc.label %> (@<%= acc.github_user %>)<%= acc.is_default ? ' [default]' : '' %></option>
          <% }); %>
        </select>
        <span class="help-text"><%= t('field.accountAutoHint') %></span>
      </div>
      <div class="form-group">
        <label for="groupName"><%= t('field.group') %></label>
        <input type="text" id="groupName" name="groupName" placeholder="<%= t('placeholder.group') %>">
        <span class="help-text"><%= t('field.groupHint') %></span>
      </div>
      <div class="form-group">
        <label for="localPath"><%= t('field.localPath') %></label>
        <input type="text" id="localPath" name="localPath" required placeholder="<%= t('placeholder.localPath') %>" autocomplete="off">
        <span class="help-text"><%= t('add.localPathHint') %></span>
        <div class="folder-browser" id="folderBrowser">
          <div class="fb-breadcrumbs" id="fbBreadcrumbs"></div>
          <div class="fb-list" id="fbList">
            <div class="fb-loading"><%= t('loader.loading') %></div>
          </div>
          <div class="fb-selected-path" id="fbSelectedPath" style="display:none">
            <span>&#128193;</span>
            <span id="fbSelectedText"></span>
            <button type="button" class="fb-select-btn" onclick="selectFolder()"><%= t('button.select') %></button>
          </div>
        </div>
      </div>
      <div class="form-group">
        <label for="remote"><%= t('field.remote') %></label>
        <input type="text" id="remote" name="remote" placeholder="<%= t('placeholder.remote') %>">
        <span class="help-text"><%= t('field.remoteHint') %></span>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-success"><%= t('button.add') %></button>
        <a href="/repos" class="btn btn-secondary"><%= t('button.cancel') %></a>
      </div>
    </form>
  </div>
</div>

<script>
(function() {
  var prefix = document.getElementById('noAccountPrefix');
  var suffix = document.getElementById('noAccountSuffix');
  if (prefix && suffix) {
    var raw = "<%= t('alert.noAccounts') %>";
    var parts = raw.split('{link}');
    prefix.textContent = parts[0] || '';
    suffix.textContent = parts.length > 1 ? parts[1] : '';
  }
})();

var currentPath = '<%= typeof browseRoot !== "undefined" && browseRoot ? browseRoot : "/home" %>';
var browseRootPath = currentPath;
var selectedFolder = null;
var agentId = ''; // '' = server, anders node-id
var entryMeta = {};

function L(key) { return (window.I18N && window.I18N[key]) || key; }

function esc(text) {
  return String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function browseEndpoint(dirPath) {
  if (agentId) return '/repos/nodes/' + agentId + '/browse?path=' + encodeURIComponent(dirPath);
  return '/repos/browse?path=' + encodeURIComponent(dirPath);
}

function relParts(fullPath, root) {
  var r = String(root || '/').replace(/[\/\\]+$/, '');
  if (r === '/') return String(fullPath).split(/[\/\\]/).filter(Boolean);
  var fullNorm = String(fullPath).replace(/\\/g, '/');
  var rootNorm = r.replace(/\\/g, '/');
  if (fullNorm === rootNorm) return [];
  if (fullNorm.indexOf(rootNorm + '/') === 0) return fullNorm.slice(rootNorm.length).split('/').filter(Boolean);
  return fullNorm.split('/').filter(Boolean);
}

function buildBreadcrumbs(fullPath) {
  var root = browseRootPath || '/';
  var parts = relParts(fullPath, root);
  var rootLabel = root === '/' ? '/' : root;
  var html = '<a href="#" data-path="' + esc(root) + '" onclick="navigateTo(this.dataset.path)">' + esc(rootLabel) + '</a>';
  var built = String(root).replace(/[\/\\]+$/, '');
  for (var i = 0; i < parts.length; i++) {
    built += '/' + parts[i];
    if (i === parts.length - 1) {
      html += '<span class="fb-sep">/</span><span class="fb-current">' + esc(parts[i]) + '</span>';
    } else {
      html += '<span class="fb-sep">/</span><a href="#" data-path="' + esc(built) + '" onclick="navigateTo(this.dataset.path)">' + esc(parts[i]) + '</a>';
    }
  }
  return html;
}

async function navigateTo(dirPath) {
  currentPath = dirPath;
  document.getElementById('fbBreadcrumbs').innerHTML = buildBreadcrumbs(dirPath);
  document.getElementById('fbList').innerHTML = '<div class="fb-loading">' + L('loaderLoading') + '</div>';
  document.getElementById('fbSelectedPath').style.display = 'none';
  selectedFolder = null;

  try {
    var res = await fetch(browseEndpoint(dirPath));
    var data = await res.json();
    renderEntries(data);
  } catch (e) {
    document.getElementById('fbList').innerHTML = '<div class="fb-loading">' + L('loaderError') + '</div>';
  }
}

function renderEntries(data) {
  var list = document.getElementById('fbList');
  if (data.error) {
    list.innerHTML = '<div class="fb-loading">' + data.error + '</div>';
    return;
  }
  if (data.entries.length === 0) {
    list.innerHTML = '<div class="fb-loading">' + L('loaderEmpty') + '</div>';
    return;
  }

  entryMeta = {};
  var html = '';
  if (data.parent !== null && data.parent !== data.path) {
    html += '<div class="fb-entry" data-parent="' + esc(data.parent) + '" onclick="navigateTo(this.dataset.parent)">';
    html += '<span class="fb-icon">&#8617;</span>';
    html += '<span class="fb-name" style="color:var(--text-muted)">' + L('loaderBack') + '</span>';
    html += '</div>';
  }

  for (var i = 0; i < data.entries.length; i++) {
    var e = data.entries[i];
    if (e.type === 'dir') {
      entryMeta[e.path] = { remote: e.remote || '', name: e.name };
      html += '<div class="fb-entry' + (selectedFolder === e.path ? ' selected' : '') + '" data-path="' + esc(e.path) + '" onclick="openFolder(this)" ondblclick="navigateTo(this.dataset.path)">';
      html += '<span class="fb-icon">&#128193;</span>';
      html += '<span class="fb-name">' + escapeHtml(e.name) + '/</span>';
      if (e.hasGit) html += '<span class="fb-tag git-tag">GIT</span>';
      html += '</div>';
    } else {
      html += '<div class="fb-entry" style="opacity:0.5">';
      html += '<span class="fb-icon">&#128196;</span>';
      html += '<span class="fb-name">' + escapeHtml(e.name) + '</span>';
      html += '</div>';
    }
  }
  list.innerHTML = html;
}

function applyDetectedRemote(folderPath) {
  var meta = entryMeta[folderPath];
  if (!meta || !meta.remote) return;
  document.getElementById('remote').value = meta.remote;
  var nameInput = document.getElementById('name');
  if (!nameInput.value.trim()) nameInput.value = meta.remote.split('/').pop();
}

function openFolder(el) {
  var folderPath = el.dataset.path;
  selectedFolder = folderPath;
  document.getElementById('fbSelectedPath').style.display = 'flex';
  document.getElementById('fbSelectedText').textContent = folderPath;
  document.getElementById('localPath').value = folderPath;
  applyDetectedRemote(folderPath);

  var entries = document.querySelectorAll('.fb-entry');
  for (var i = 0; i < entries.length; i++) {
    entries[i].classList.toggle('selected', entries[i].dataset.path === folderPath);
  }
}

function selectFolder() {
  if (selectedFolder) {
    document.getElementById('localPath').value = selectedFolder;
    applyDetectedRemote(selectedFolder);
  }
}

function escapeHtml(text) {
  return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

var githubPicker = document.getElementById('githubPicker');
var pickerPlaceholder = "<%= t('add.pickGithubPlaceholder') %>";
var pickerLoading = "<%= t('add.pickGithubLoading') %>";
var pickerEmpty = "<%= t('add.pickGithubEmpty') %>";
var pickerError = "<%= t('add.pickGithubError') %>";

function loadGithubRepos() {
  if (!githubPicker) return;
  var accountSelect = document.getElementById('accountId');
  var accountId = accountSelect ? accountSelect.value : '';
  githubPicker.innerHTML = '<option value="">' + esc(pickerLoading) + '</option>';
  fetch('/repos/github-repos' + (accountId ? '?accountId=' + encodeURIComponent(accountId) : ''))
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.error) {
        githubPicker.innerHTML = '<option value="">' + esc(data.error) + '</option>';
        return;
      }
      if (!data.repos || !data.repos.length) {
        githubPicker.innerHTML = '<option value="">' + esc(pickerEmpty) + '</option>';
        return;
      }
      var html = '<option value="">' + esc(pickerPlaceholder) + '</option>';
      data.repos.forEach(function(r) {
        html += '<option value="' + esc(r.fullName) + '">' + esc(r.fullName) + (r.private ? ' (private)' : '') + '</option>';
      });
      githubPicker.innerHTML = html;
    })
    .catch(function() {
      githubPicker.innerHTML = '<option value="">' + esc(pickerError) + '</option>';
    });
}

if (githubPicker) {
  githubPicker.addEventListener('change', function() {
    if (!this.value) return;
    document.getElementById('remote').value = this.value;
    document.getElementById('name').value = this.value.split('/').pop();
  });
  var accountSelectEl = document.getElementById('accountId');
  if (accountSelectEl) accountSelectEl.addEventListener('change', loadGithubRepos);
  loadGithubRepos();
}

var agentSelect = document.getElementById('agentId');
agentSelect.addEventListener('change', function() {
  agentId = this.value;
  selectedFolder = null;
  document.getElementById('localPath').value = '';
  document.getElementById('fbSelectedPath').style.display = 'none';

  if (agentId) {
    document.getElementById('fbList').innerHTML = '<div class="fb-loading">' + L('loaderLoading') + '</div>';
    fetch('/repos/nodes/' + agentId + '/browse?path=')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.error) {
          document.getElementById('fbList').innerHTML = '<div class="fb-loading">' + (data.error || L('loaderError')) + '</div>';
          document.getElementById('agentHelp').innerHTML = '<span style="color:var(--red)">' + (data.error || L('loaderError')) + ' \u2014 werk de agent bij via de Nodes-pagina (Agent-pakket downloaden) als dit blijft.</span>';
          return;
        }
        browseRootPath = (data.roots && data.roots.length) ? data.roots[0] : (data.path || '/');
        currentPath = browseRootPath;
        navigateTo(currentPath);
      })
      .catch(function() {
        document.getElementById('fbList').innerHTML = '<div class="fb-loading">' + L('loaderError') + '</div>';
      });
  } else {
    browseRootPath = '<%- typeof browseRoot !== "undefined" && browseRoot ? JSON.stringify(browseRoot) : "/home" %>';
    currentPath = browseRootPath;
    navigateTo(currentPath);
  }
});

navigateTo(currentPath);
</script>
<%- include('partials/footer') %>