    </main>
  </div>
    <!-- PWA + offline scripts -->
  <script>
  (function() {
    var deferredPrompt = null;
    var installBanner = document.getElementById('pwaInstallBanner');
    var offlineIndicator = document.getElementById('offlineIndicator');

    // Detecteer beforeinstallprompt (PWA)
    window.addEventListener('beforeinstallprompt', function(e) {
      e.preventDefault();
      deferredPrompt = e;
      if (installBanner) installBanner.style.display = 'flex';
    });

    window.installPWA = function() {
      if (installBanner) installBanner.style.display = 'none';
      if (!deferredPrompt) return;
      deferredPrompt.prompt();
      deferredPrompt.userChoice.then(function() {
        deferredPrompt = null;
      });
    };

    window.dismissPWA = function() {
      if (installBanner) installBanner.style.display = 'none';
      deferredPrompt = null;
    };

    // Online/offline detectie
    function updateOnlineStatus() {
      if (offlineIndicator) {
        offlineIndicator.style.display = navigator.onLine ? 'none' : 'block';
      }
    }
    window.addEventListener('online', updateOnlineStatus);
    window.addEventListener('offline', updateOnlineStatus);
    updateOnlineStatus();
  })();
  </script>
</body>
</html>