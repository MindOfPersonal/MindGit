# MariaDB
DB_HOST=localhost
DB_USER=github
DB_PASSWORD=verander-mij
DB_NAME=github
DB_CONNECTION_LIMIT=10

# Express session secret (lange willekeurige string, minimaal 32 tekens).
# In productie (NODE_ENV=production) weigert de app te starten bij een
# ontbrekende of te korte waarde.
SESSION_SECRET=verander-mij-in-een-lange-willekeurige-string

# Sessie idle-timeout in milliseconden (standaard 2 uur = 7200000).
# Je wordt uitgelogd na deze periode van inactiviteit.
SESSION_TTL_MS=7200000

# API bearer-token levensduur in milliseconden (standaard 7 dagen = 604800000).
# 0 = nooit verlopen (niet aanbevolen).
API_TOKEN_TTL_MS=604800000

# Hoe vaak (in ms) een git fetch naar de remote mag gebeuren voor live status.
# De dashboard toont "behind/actie nodig" pas weer als dit interval verstreken is.
# Lagere waarde = snellere detectie van remote commits, maar meer netwerkverkeer.
GIT_FETCH_INTERVAL=15000

# Maximaal aantal git fetch-processen dat tegelijk draait. Voorkomt dat een
# dashboard-refresh voor veel repo's de machine en GitHub overbelast.
GIT_FETCH_CONCURRENCY=4

# Node/agent-status: een node zonder heartbeat wordt na deze periode (ms)
# offline gezet. Draai dit niet te krap: agents sturen standaard elke 30s.
NODE_STALE_AFTER_MS=90000

# Hoe vaak (ms) de server verouderde node-statussen opruimt en ping/pong doet.
NODE_SWEEP_INTERVAL_MS=30000

# Encryptie key voor gevoelige database waarden (GitHub token).
# Genereer met: node scripts/generate-key.js
TOKEN_ENCRYPTION_KEY=verander-mij-genereren-met-node-scripts-generate-key-js

# Server poort en bind-adres (achter nginx: HOST=127.0.0.1)
HOST=0.0.0.0
PORT=3050

# Whitelist voor /repos/browse (komma-gescheiden absolute paden)
# Vul je eigen gebruikersmap of projectmappen in. VERPLICHT om veilig te zijn.
BROWSE_ROOTS=/home/your-username

# GitHub (optioneel, wordt bij opstarten naar DB geschreven inden leeg)
GITHUB_TOKEN=
GITHUB_USER=

# Secret voor het verifiëren van GitHub webhook handtekeningen (X-Hub-Signature-256).
# Configureer hetzelfde secret in de GitHub webhook settings. Verplicht in productie.
GITHUB_WEBHOOK_SECRET=

# Node/Agent configuratie
# COORDINATOR_URL wordt door agents gebruikt om verbinding te maken met de centrale server
# COORDINATOR_URL=http://your-server:3050
# NODE_KEY is de node-key uit het dashboard (Node toevoegen) en hoort op de agent-machine thuis
# NODE_KEY=your-node-key-from-dashboard

# Git timeouts (milliseconden) - optioneel
GIT_TIMEOUT=15000
GIT_LONG_TIMEOUT=30000
# Back-ups (optioneel; default ./backups)
BACKUP_DIR=
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=0
VAPID_SUBJECT=mailto:admin@example.com
